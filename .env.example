# Copy to .env and fill in. `python config.py` shows what is set (masked).

# ---------------------------------------------------------------------------
# IMIQ FIWARE gateway: QuantumLeap (history) and Orion (current metadata).
# The public endpoints need no api key; the defaults below are correct.
# ---------------------------------------------------------------------------
QL_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/quantumleap
ORION_BASE_URL=https://imiq-public.et.uni-magdeburg.de/api/orion
# Optional: sent as the x-api-key header if set.
FIWARE_API_KEY=
# Multi-tenant headers; leave empty unless the IMIQ team says otherwise.
FIWARE_SERVICE=
FIWARE_SERVICE_PATH=

# ---------------------------------------------------------------------------
# LLM writer + verifier (OpenAI Responses API).
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
WRITER_MODEL=gpt-5.4
VERIFIER_MODEL=gpt-5.4
# Reasoning effort none|low|medium|high, and per-call timeout in seconds.
LLM_REASONING=medium
LLM_TIMEOUT_S=180

# ---------------------------------------------------------------------------
# Outbound email. The bot sends from its OWN mailbox; any SMTP provider works
# (Gmail app password with 2FA on, GMX, an OVGU functional address).
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=dashbot.your.bot.address@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_NAME=Imidillo

# ---------------------------------------------------------------------------
# Report. One address, or several separated by commas (all get the same
# email and see each other in To). Language: en | de | tr.
# ---------------------------------------------------------------------------
REPORT_EMAIL_TO=you@example.com
REPORT_LANGUAGE=en
